<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusPing.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="18">

            <Label Text="Appearance" FontSize="18" FontAttributes="Bold" />
            <VerticalStackLayout Spacing="6">
                <Label Text="Theme" FontSize="14" />
                <Picker ItemsSource="{Binding ThemeOptions}"
                        SelectedIndex="{Binding ThemeIndex}"
                        Title="Theme" />
                <Label Text="Changes apply immediately when you save."
                       FontSize="11" Opacity="0.6" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Opacity="0.15" />

            <Label Text="Watching" FontSize="18" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="{Binding PollSeconds, StringFormat='Poll every {0} seconds'}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Stepper Grid.Column="1"
                         Minimum="5"
                         Maximum="60"
                         Increment="5"
                         Value="{Binding PollSeconds}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="{Binding DefaultLeadMinutes, StringFormat='Default warning: {0} minutes before'}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Stepper Grid.Column="1"
                         Minimum="1"
                         Maximum="30"
                         Increment="1"
                         Value="{Binding DefaultLeadMinutes}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Notification sound"
                       FontSize="14" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Confirm before deleting"
                       FontSize="14" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ConfirmBeforeDelete}" />
            </Grid>

            <Button Text="Save settings" Command="{Binding SaveCommand}" />
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#D9480F"
                   FontSize="12" />

            <BoxView HeightRequest="1" Opacity="0.15" />

            <Label Text="Data" FontSize="18" FontAttributes="Bold" />
            <Label Text="BusPing reads the public GTFS feed and live vehicle positions published by the Târgu Mureș local transport operator."
                   FontSize="13" Opacity="0.75" />
            <Button Text="Refresh schedule now"
                    Command="{Binding RefreshScheduleCommand}"
                    FontSize="13" />
            <Label Text="{Binding ScheduleStatus}" FontSize="12" Opacity="0.7" />

            <BoxView HeightRequest="1" Opacity="0.15" />

            <Label Text="About" FontSize="18" FontAttributes="Bold" />
            <Label Text="BusPing 1.0 — student project. Live data: live.transportlocal.ro. Schedules: GTFS feed from the same host."
                   FontSize="12" Opacity="0.65" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
