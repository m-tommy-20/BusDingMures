<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusPing.Views.WatchEditorPage"
    x:Name="EditorRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <Grid Padding="14,10" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6">

        <Entry Grid.Row="0"
               Placeholder="Watch name (optional)"
               Text="{Binding Name}" />

        <Picker Grid.Row="1"
                Title="Line"
                ItemsSource="{Binding Routes}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedRoute}" />

        <Picker Grid.Row="2"
                Title="Direction"
                ItemsSource="{Binding Directions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedDirection}" />

        <Label Grid.Row="3"
               Text="{Binding SelectionSummary}"
               FontSize="12"
               Opacity="0.75" />

        <CollectionView Grid.Row="4" ItemsSource="{Binding Stops}">
            <CollectionView.EmptyView>
                <Label Text="Choose a line to load its stops."
                       FontSize="14"
                       Opacity="0.65"
                       Margin="4,16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5" ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="6">
                        <Label Grid.Column="0"
                               Text="{Binding Time}"
                               FontSize="12"
                               Opacity="0.65"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding DisplayName}"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="{Binding BoardingButtonText}"
                                FontSize="11"
                                Padding="8,4"
                                Command="{Binding Source={x:Reference EditorRoot}, Path=BindingContext.SelectBoardingCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3"
                                Text="{Binding AlertButtonText}"
                                FontSize="11"
                                Padding="8,4"
                                IsEnabled="{Binding CanAlert}"
                                Command="{Binding Source={x:Reference EditorRoot}, Path=BindingContext.ToggleAlertCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="5" Spacing="6">
            <BoxView HeightRequest="1" Opacity="0.15" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding DayPresets}"
                        SelectedIndex="{Binding DayPresetIndex}"
                        Title="Days" />
                <Stepper Grid.Column="1"
                         Minimum="1"
                         Maximum="30"
                         Increment="1"
                         Value="{Binding LeadMinutes}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="From" FontSize="12" VerticalOptions="Center" />
                <TimePicker Grid.Column="1" Time="{Binding StartTime}" Format="HH:mm" />
                <Label Grid.Column="2" Text="To" FontSize="12" VerticalOptions="Center" />
                <TimePicker Grid.Column="3" Time="{Binding EndTime}" Format="HH:mm" />
            </Grid>

            <Label Text="{Binding LeadMinutes, StringFormat='Warn time: {0} minutes before the bus reaches your stop'}"
                   FontSize="11"
                   Opacity="0.7" />

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#D9480F"
                   FontSize="12" />

            <Button Text="Save watch" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
