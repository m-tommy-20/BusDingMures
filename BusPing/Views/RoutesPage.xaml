<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusPing.Views.RoutesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Routes">

    <Grid Padding="16" RowDefinitions="Auto,Auto,220,Auto,Auto,*" RowSpacing="8">
        <SearchBar Grid.Row="0"
                   Placeholder="Search line number or name"
                   Text="{Binding SearchText}" />

        <Label Grid.Row="1"
               Text="{Binding TimelineSummary}"
               FontSize="13"
               Opacity="0.75" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Routes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRoute}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10" ColumnDefinitions="60,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="{Binding Subtitle}" FontSize="14" />
                            <Label Text="{Binding Detail}" FontSize="11" Opacity="0.65" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Picker Grid.Row="3"
                Title="Direction"
                ItemsSource="{Binding Directions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedDirection}" />

        <Label Grid.Row="4"
               Text="Stop timeline"
               FontSize="16"
               FontAttributes="Bold" />

        <CollectionView Grid.Row="5" ItemsSource="{Binding Timeline}">
            <CollectionView.EmptyView>
                <Label Text="Choose a line and a direction to see its stops."
                       Opacity="0.65"
                       FontSize="14"
                       Margin="4,12" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,6" ColumnDefinitions="56,*,44" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding Time}" FontSize="13" Opacity="0.7" />
                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" />
                        <Label Grid.Column="2"
                               Text="{Binding SequenceText}"
                               FontSize="11"
                               Opacity="0.5"
                               HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
