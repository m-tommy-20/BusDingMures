<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusPing.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="BusPing">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="14">
            <Label Text="BusPing" FontSize="32" FontAttributes="Bold" />
            <Label Text="Live bus alerts for Târgu Mureș"
                   FontSize="14" Opacity="0.7" />

            <Border Padding="16"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E3E3EA, Dark=#33333C}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ScheduleStatus}" FontSize="14" />
                    <Label Text="{Binding LiveStatus}" FontSize="14" />
                    <Label Text="{Binding VehicleCount, StringFormat='{0} vehicles on the road'}"
                           FontSize="22" FontAttributes="Bold" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Refresh now" Command="{Binding RefreshCommand}" />

            <Border Padding="14"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{AppThemeBinding Light=#E3E3EA, Dark=#33333C}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Background alerts" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding WatchingText}" FontSize="12" Opacity="0.75" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Start watching"
                                FontSize="12"
                                Padding="10,6"
                                IsVisible="{Binding IsNotWatching}"
                                Command="{Binding StartWatchingCommand}" />
                        <Button Text="Stop watching"
                                FontSize="12"
                                Padding="10,6"
                                IsVisible="{Binding IsWatching}"
                                Command="{Binding StopWatchingCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#D9480F"
                   FontSize="13" />

            <Label Text="Your watches" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="No watches yet — add your first route on the Watches tab."
                   IsVisible="{Binding IsEmpty}"
                   Opacity="0.7"
                   FontSize="14" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Watches}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Stroke="{AppThemeBinding Light=#E3E3EA, Dark=#33333C}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding RouteLine}" FontSize="13" />
                                <Label Text="{Binding BoardingLine}" FontSize="13" />
                                <Label Text="{Binding AlertLine}" FontSize="13" />
                                <Label Text="{Binding WindowText}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
